# Attendance kiosk settings. Installed to /etc/default/attendance-kiosk, which
# lives outside the repo so `git pull` never overwrites it.
# Apply changes with:  sudo systemctl restart attendance-kiosk

# Which UI to launch:
#   demo   - no login, minimal UI, lightest on a 1GB board
#   kiosk  - full React app WITH the login screen
#   simple - lightweight terminal UI, with login
# NOTE: demo mode disables authentication entirely. On an always-on device
# reachable from the network, prefer kiosk.
ATTENDANCE_APP_MODE=demo

# Breath sensor: "spi" drives the real board, "mock" simulates readings and
# never runs the pump.
ATTENDANCE_BREATH_ANALYZER_MODE=mock

# Browser used for the full-screen window. Leave unset to auto-detect
# (Chromium family first, then Firefox).
#
# Set this if the screen stays blank while the service reports healthy. On the
# Radxa Cubie A5e the packaged Chromium dies instantly with SIGILL ("Illegal
# instruction"): it leaves a <defunct> process, logs nothing, and no flag
# fixes it. Firefox works there:
# ATTENDANCE_APP_BROWSER=/usr/bin/firefox-esr

# Camera. Lower these further if the preview still feels heavy.
# ATTENDANCE_CAMERA_FRAMERATE=15
# ATTENDANCE_CAMERA_WIDTH=640
# ATTENDANCE_CAMERA_HEIGHT=480

# Uncomment to brighten a dark preview (higher = brighter, 0 disables).
# ATTENDANCE_CAMERA_AUTO_BRIGHTNESS_TARGET=130

# Seconds to wait for the X server at boot before starting anyway.
# ATTENDANCE_X_WAIT_SECONDS=60
