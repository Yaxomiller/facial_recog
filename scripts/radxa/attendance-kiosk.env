# Attendance kiosk settings. Installed to /etc/default/attendance-kiosk, which
# lives outside the repo so `git pull` never overwrites it.
# Apply changes with:  sudo systemctl restart attendance-kiosk

# Which UI to launch:
#   demo   - no login, minimal UI, lightest on a 1GB board
#   kiosk  - full React app WITH the login screen
#   simple - lightweight terminal UI, with login
# NOTE: demo mode disables authentication entirely. On an always-on device
# reachable from the network, prefer kiosk.
ATTENDANCE_APP_MODE=demo

# Breath sensor: "spi" drives the real board, "mock" simulates readings and
# never runs the pump. In "spi" mode the service user must be able to open
# /dev/spidev* and /dev/gpiochip* -- install-kiosk.sh handles that with a
# udev rule and group membership. Confirm a run is really on the board with:
#   curl -s localhost:8000/api/v2/status   -> "active_breath_analyzer":"spi"
ATTENDANCE_BREATH_ANALYZER_MODE=spi

# Seconds to wait at boot before starting the app, so the board can settle
# (X, camera ISP and the sensor rail come up after graphical.target).
# Applies only to the first start after a reboot; `systemctl restart` is
# always immediate. Set 0 to start straight away.
ATTENDANCE_BOOT_DELAY_SECONDS=60

# --- Board power monitor (TEMPORARY TESTING) --------------------------------
# INA745B on I2C pins 3/5. Needs no shunt value: the part has an integrated
# 800uOhm shunt and reports current/power with fixed LSBs. The on-screen
# readout hides itself if the chip does not respond.
# Every sample is appended to a CSV automatically while the app runs, so a
# power profile always exists without starting a capture by hand. Default is
# data/power_log.csv inside the repo; set empty to turn logging off.
# ATTENDANCE_POWER_MONITOR=0            # switch the readout off entirely
# ATTENDANCE_POWER_I2C_BUS=/dev/i2c-1   # check with: ls /dev/i2c-*
# ATTENDANCE_POWER_I2C_ADDRESS=0x40     # find with: power_monitor.py --scan
# ATTENDANCE_POWER_INTERVAL=0.5         # seconds between samples
# ATTENDANCE_POWER_CSV=/home/radxa/power_log.csv

# Browser used for the full-screen window. Leave unset to auto-detect
# (Chromium family first, then Firefox).
#
# Set this if the screen stays blank while the service reports healthy. On the
# Radxa Cubie A5e the packaged Chromium dies instantly with SIGILL ("Illegal
# instruction"): it leaves a <defunct> process, logs nothing, and no flag
# fixes it. Firefox works there, and this board IS a Cubie A5e, so it is set:
ATTENDANCE_APP_BROWSER=/usr/bin/firefox-esr

# Camera. Lower these further if the preview still feels heavy.
# ATTENDANCE_CAMERA_FRAMERATE=15
# ATTENDANCE_CAMERA_WIDTH=640
# ATTENDANCE_CAMERA_HEIGHT=480

# Uncomment to brighten a dark preview (higher = brighter, 0 disables).
# ATTENDANCE_CAMERA_AUTO_BRIGHTNESS_TARGET=130

# Seconds to wait for the X server at boot before starting anyway.
# ATTENDANCE_X_WAIT_SECONDS=60
